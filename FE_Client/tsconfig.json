{
  "compilerOptions": {
    "target": "ES2022", // or "ESNext"
    "lib": ["DOM", "ES2022"], // Include necessary libraries
    "module": "ESNext",
    "jsx": "react-jsx", // Use "react" if you're using React 17 or earlier
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node", // Use Node resolution strategy
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist", // Specify output directory for compiled files
    "noEmit": false // Ensure this is false to allow emitting files
  },
  "include": ["src/**/*"], // Ensure all source files are included
  "exclude": ["node_modules", "dist"] // Exclude unnecessary directories
}
